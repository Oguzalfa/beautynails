{
  "name": "beautynails",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir node_modules/.cache/sazi-ssr --emptyOutDir && node scripts/build-journal.mjs && node scripts/build-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "acceptance": "node scripts/acceptance.mjs",
    "test:mobile": "node scripts/mobile-layout-qa.mjs",
    "test:responsive": "node scripts/mobile-responsive-qa.mjs",
    "test:editorial": "node scripts/editorial-qa.mjs",
    "test:seo": "node scripts/seo-qa.mjs",
    "lighthouse": "lighthouse http://127.0.0.1:4174/ --only-categories=performance,accessibility --output=json --output=html --output-path=docs/beauty-nails-brief/evidence/lighthouse --chrome-flags=\"--headless --no-sandbox\" --form-factor=desktop --screenEmulation.mobile=false --screenEmulation.width=1440 --screenEmulation.height=900"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
