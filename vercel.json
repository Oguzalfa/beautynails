{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/:path*/index.html", "destination": "/:path*/", "permanent": true },
    { "source": "/", "destination": "/en/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "en" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/de/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "de" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/ru/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "ru" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/ar/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "ar" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/uz/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "uz" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/tk/", "permanent": false,
      "has": [{ "type": "cookie", "key": "bn-language", "value": "tk" }],
      "missing": [{ "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/en/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[eE][nN](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/de/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[dD][eE](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/ru/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[rR][uU](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/ar/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[aA][rR](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/uz/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[uU][zZ](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] },
    { "source": "/", "destination": "/tk/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": "^[tT][kK](?:-[A-Za-z0-9]+)*(?:,.*)?$" }],
      "missing": [{ "type": "cookie", "key": "bn-language" }, { "type": "query", "key": "lang" }] }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Vary", "value": "Accept-Language, Cookie" }] },
    { "source": "/(.*)", "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
